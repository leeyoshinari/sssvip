<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- 顶部 Tab 栏 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E1E1E"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:tabIndicatorColor="#E50914"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#80FFFFFF" />

    <!-- 网页与悬浮层容器 -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabLayout">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false" />

        <!-- 1. 位置调整至左上角 top|start，去掉默认 elevation 避免挡住光标 -->
        <Button
            android:id="@+id/btnVipParse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:backgroundTint="#E50914"
            android:elevation="0dp"
            android:focusable="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:stateListAnimator="@null"
            android:text="⚡ VIP 立即解析播放"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 2. 增加 android:elevation="10dp"，确保虚拟光标永远处于最顶层 -->
        <com.example.vvvip.CursorView
            android:id="@+id/cursorView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:elevation="10dp"
            android:visibility="gone" />
    </FrameLayout>
</RelativeLayout>